# Copy this file to .env.local and replace placeholders with your own values.
# Never commit .env.local or put real credentials in this example file.

# Required: shared Turso/libSQL database for login, accounts, and music data.
MUSIC_TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
MUSIC_TURSO_AUTH_TOKEN=your-turso-auth-token

# Local app URLs. Keep localhost for local development.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for account verification and password-reset emails.
RESEND_API_KEY=re_your-resend-api-key
# Optional; defaults to onboarding@resend.dev.
# For production, use a sender address verified with Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional PayPal integration. Sandbox is the default.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
# NEXT_PUBLIC_PAYPAL_CLIENT_ID must match PAYPAL_CLIENT_ID if using PayPal checkout.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id

# Optional: these defaults are used when not set.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# NEXT_PUBLIC_SAMPLE_BASE_URL=/samples
